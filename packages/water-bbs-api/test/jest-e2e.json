{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/configure(|/.*)$": "<rootDir>/../libs/configure/src/$1",
    "^@app/engine(|/.*)$": "<rootDir>/../libs/engine/src/$1",
    "^@app/gamification(|/.*)$": "<rootDir>/../libs/gamification/src/$1",
    "^@app/notification(|/.*)$": "<rootDir>/../libs/notification/src/$1",
    "^@app/shared(|/.*)$": "<rootDir>/../libs/shared/src/$1",
    "^@app/translation(|/.*)$": "<rootDir>/../libs/translation/src/$1",
    "^@app/verification-code(|/.*)$": "<rootDir>/../libs/verification-code/src/$1"
  }
}