{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "strictPropertyInitialization": false,
    "types": [
      "@types/express",
      "vitest/globals"
    ],
    "paths": {
      "@app/configure": [
        "libs/configure/src"
      ],
      "@app/configure/*": [
        "libs/configure/src/*"
      ],
      "@app/engine": [
        "libs/engine/src"
      ],
      "@app/engine/*": [
        "libs/engine/src/*"
      ],
      "@app/gamification": [
        "libs/gamification/src"
      ],
      "@app/gamification/*": [
        "libs/gamification/src/*"
      ],
      "@app/notification": [
        "libs/notification/src"
      ],
      "@app/notification/*": [
        "libs/notification/src/*"
      ],
      "@app/shared": [
        "libs/shared/src"
      ],
      "@app/shared/*": [
        "libs/shared/src/*"
      ],
      "@app/verification-code": [
        "libs/verification-code/src"
      ],
      "@app/verification-code/*": [
        "libs/verification-code/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "libs/**/*",
    "types/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}