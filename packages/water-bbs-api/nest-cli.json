{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": ".swcrc"
      }
    },
    "assets": [
      {
        "include": "../libs/translation/**/*",
        "watchAssets": true,
        "outDir": "dist/translation"
      },
      {
        "include": "../configs/**/*",
        "watchAssets": true,
        "outDir": "dist/configs"
      },
      {
        "include": "../templates/**/*",
        "watchAssets": true,
        "outDir": "dist/templates"
      }
    ],
    "webpack": true
  },
  "projects": {
    "configure": {
      "type": "library",
      "root": "libs/configure",
      "entryFile": "index",
      "sourceRoot": "libs/configure/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configure/tsconfig.lib.json"
      }
    },
    "notification": {
      "type": "library",
      "root": "libs/notification",
      "entryFile": "index",
      "sourceRoot": "libs/notification/src",
      "compilerOptions": {
        "tsConfigPath": "libs/notification/tsconfig.lib.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "verification-code": {
      "type": "library",
      "root": "libs/verification-code",
      "entryFile": "index",
      "sourceRoot": "libs/verification-code/src",
      "compilerOptions": {
        "tsConfigPath": "libs/verification-code/tsconfig.lib.json"
      }
    }
  }
}