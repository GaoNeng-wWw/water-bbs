FROM ghcr.io/pnpm/pnpm:11.7.0 as base

WORKDIR /app

COPY package.json ./

RUN pnpm install --dangerously-allow-all-builds

COPY . .

VOLUME /app/dist/config /app/dist/lua /app/dist/templates /app/dist/translation

FROM base as prod

CMD ["pnpm", "start"]
 
FROM base as test

COPY ./src/configs/config.ci.json /app/dist/config/config.json

CMD ["pnpm", "test:e2e"]